# ─────────────────────────────────────────────────────────────
#  SolGuard / V5 Alpha — .gitignore
#  Rule of this file: anything that can spend, sign, or pay
#  never leaves this machine. When in doubt, ignore it.
# ─────────────────────────────────────────────────────────────

# ── Secrets & environment (NEVER commit) ─────────────────────
.env
.env.*
*.env
!*.env.example
.env.Solana
env_Solana.txt
V5 Alpha SOL STUFF.txt
*STUFF*.txt
*API*.txt

# ── Key material ─────────────────────────────────────────────
*.pem
*.key
*.p12
*.keystore
keypair*.json
*keypair*.json
id.json
wallet*.json

# ── Anthropic / vendor credentials if ever dropped here ──────
*TOKEN*.txt
*CLAUDE*.txt
*DeepSeek*.txt

# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo

# ── Runtime logs (regenerated by the engine) ─────────────────
logs/
*.log
npm-debug.log*

# ── Editor / OS noise ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

